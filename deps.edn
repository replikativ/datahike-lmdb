{:deps {org.clojure/clojure                 {:mvn/version "1.12.0" :scope "provided"}
        ;; BORING CODEC. datahike 0.8.1777 shipped `datahike.cbor`, whose
        ;; PSS/Datom/DB handlers install into konserve-lmdb's boring `:registry`
        ;; (0.1.17+). boring resolves to 0.1.21 transitively via datahike. See
        ;; src/datahike_lmdb/core.clj for the registry wiring (+ legacy decode).
        org.replikativ/datahike              {:mvn/version "0.8.1777"}
        org.replikativ/persistent-sorted-set {:mvn/version "0.5.140"}
        org.replikativ/konserve              {:mvn/version "0.9.372"}
        org.replikativ/konserve-lmdb         {:mvn/version "0.1.19"}}

 :paths ["src"]

 :aliases {:dev {:extra-paths ["test" "bench"]
                 :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
                 :extra-deps {nrepl/nrepl {:mvn/version "1.3.0"}}}

           :test {:extra-paths ["test"]
                  :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
                  :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}}
                  :main-opts ["-m" "kaocha.runner"]}

           :bench {:extra-paths ["bench"]
                   :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
                   :extra-deps {datalevin/datalevin {:mvn/version "0.9.27"}}}

           :bench/basic {:extra-paths ["bench"]
                         :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
                         :extra-deps {datalevin/datalevin {:mvn/version "0.9.27"}}
                         :main-opts ["-m" "datahike-lmdb.benchmark"]}

           :bench/wiki {:extra-paths ["bench"]
                        :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
                        :extra-deps {datalevin/datalevin {:mvn/version "0.9.27"}}
                        :main-opts ["-m" "datahike-lmdb.wiki-benchmark"]}

           :format {:extra-deps {cljfmt/cljfmt {:mvn/version "0.9.2"}}
                    :main-opts ["-m" "cljfmt.main" "check"]}

           :ffix {:extra-deps {cljfmt/cljfmt {:mvn/version "0.9.2"}}
                  :main-opts ["-m" "cljfmt.main" "fix"]}

           :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.5"}
                          slipset/deps-deploy {:mvn/version "0.2.2"}
                          io.github.borkdude/gh-release-artifact {:git/sha "b946558225a7839f6a0f644834e838e190dc2262"}}
                   :ns-default build}}}
